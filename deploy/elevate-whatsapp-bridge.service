[Unit]
Description=ElevateBox Sarvam to WhatsApp Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elevate-wa
Group=elevate-wa
WorkingDirectory=/srv/elevate-whatsapp-bridge
Environment=CALLBACK_DISPATCH_MODE=disabled
EnvironmentFile=/etc/elevate-whatsapp-bridge.env
Environment=CALLBACKS_PATH=/var/lib/elevate-whatsapp-bridge/callbacks.json
Environment=OUTBOUND_EVENTS_PATH=/var/lib/elevate-whatsapp-bridge/outbound-events.json
Environment=EVALUATION_JOBS_PATH=/var/lib/elevate-whatsapp-bridge/evaluation-jobs.json
Environment=FEEDBACK_PATH=/var/lib/elevate-whatsapp-bridge/feedback.json
Environment=EVALUATION_CASES_PATH=/var/lib/elevate-whatsapp-bridge/evaluation-cases.json
Environment=RECOMMENDATIONS_PATH=/var/lib/elevate-whatsapp-bridge/recommendations.json
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/elevate-whatsapp-bridge

[Install]
WantedBy=multi-user.target
